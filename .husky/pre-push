#!/usr/bin/env sh
# Pre-push gate. Refuses the push if ANY of these fail:
#   1. backend typecheck (`tsc --noEmit`)
#   2. backend lint (`eslint src` — exits non-zero on errors, not warnings)
#   3. backend vitest suite with 100% coverage thresholds on
#      lines / branches / functions / statements (config:
#      backend/vitest.config.ts COVERAGE_EXCLUDES + thresholds)
#
# The order is: cheapest first, slowest last. Typecheck fails in ~3s and
# catches the obvious "you didn't compile-check before pushing" cases.
# Lint fails in ~10s. The full coverage suite runs in ~3 minutes and is
# the heaviest gate.
#
# CI re-asserts all three steps in deploy.yml; this hook makes red CI
# impossible from this machine. If any gate is failing locally, fix
# the underlying issue — DO NOT bypass with `git push --no-verify`.
#
# To run the same checks manually:
#   pnpm --filter @mythrun/backend typecheck
#   pnpm --filter @mythrun/backend lint
#   pnpm --filter @mythrun/backend test:coverage

set -e

echo "→ pre-push gate (1/3): backend typecheck"
pnpm --filter @mythrun/backend typecheck

echo "→ pre-push gate (2/3): backend lint"
pnpm --filter @mythrun/backend lint

echo "→ pre-push gate (3/3): backend vitest suite + 100% coverage threshold"
pnpm --filter @mythrun/backend test:coverage
