#!/usr/bin/env sh
# Pre-push gate. Refuses the push if ANY of these fail:
#   0. build @mythrun/contract — the backend (and the frontend consumers)
#      import its compiled dist/; the typecheck/test gates below resolve the
#      built output, so it MUST be built first.
#   1. Auth Lint — mirrors .github/workflows/lint-auth.yml (forbid unsafe
#      narrowing of request.user outside the auth module + tests).
#   2. backend typecheck (`tsc --noEmit`)
#   3. backend lint (`eslint src` — exits non-zero on errors, not warnings)
#   4. backend vitest suite with 100% coverage thresholds on
#      lines / branches / functions / statements (config:
#      backend/vitest.config.ts COVERAGE_EXCLUDES + thresholds)
#   5. wiki source-hash freshness (`pnpm wiki:check`) — mirrors the wiki
#      CI workflow. Requires backend/.env.development so the schema page
#      can resolve against a live Postgres.
#   6. dev-tool verifier (`pnpm dev-tool:verify`) — only when the diff
#      touches backend/dev-tool/** or the backend contract route sources.
#
# Order: cheapest first, slowest last. Auth Lint is a single grep (~1s),
# typecheck ~3s, lint ~10s, full coverage suite ~3min, wiki:check ~2s.
#
# CI re-asserts all six steps (lint-auth.yml + deploy.yml + wiki.yml);
# this hook makes red CI impossible from this machine. If any gate is
# failing locally, fix the underlying issue — DO NOT bypass with
# `git push --no-verify`.
#
# To run the same checks manually:
#   grep -rEn 'request\.user[!?]\.|request\.user as ' \
#     backend/src/ --include='*.ts' \
#     --exclude-dir=__tests__ --exclude-dir=auth
#   pnpm --filter @mythrun/backend typecheck
#   pnpm --filter @mythrun/backend lint
#   pnpm --filter @mythrun/backend test:coverage
#   set -a && . backend/.env.development && set +a && pnpm wiki:check
#   pnpm dev-tool:verify

set -e

echo "→ pre-push gate (0/7): build @mythrun/contract"
# The backend's typecheck/lint/coverage gates and the frontend consumers all
# import @mythrun/contract's compiled dist/. Build it first so every gate
# below resolves the built output rather than failing on a missing module.
pnpm --filter @mythrun/contract build

echo "→ pre-push gate (1/7): auth-narrowing pattern check"
# Mirror of .github/workflows/lint-auth.yml step. grep exits 0 on match,
# 1 on no-match — invert via `if`. Forbids request.user! / request.user?
# / request.user as outside backend/src/auth/** and __tests__/**.
if grep -rEn 'request\.user[!?]\.|request\.user as ' \
    backend/src/ --include='*.ts' \
    --exclude-dir=__tests__ --exclude-dir=auth; then
  echo ""
  echo "✗ pre-push: auth-narrowing violation. Use requireUser(request) or"
  echo "  assign-then-check (const u = request.user; if (!u) ...) instead."
  exit 1
fi

echo "→ pre-push gate (2/7): backend typecheck"
pnpm --filter @mythrun/backend typecheck

echo "→ pre-push gate (3/7): backend lint"
pnpm --filter @mythrun/backend lint

echo "→ pre-push gate (4/7): backend vitest suite + 100% coverage threshold"
pnpm --filter @mythrun/backend test:coverage

echo "→ pre-push gate (5/7): wiki source-hash freshness"
# Source backend/.env.development so DATABASE_URL is set for the schema
# fragment build. The check itself is a fast hash diff against the live
# source tree (~2s). Mirrors the wiki CI workflow.
#
# The sourcing is scoped to a subshell: `set -a` exports EVERYTHING in that
# env file — including NODE_ENV=development — and an exported NODE_ENV leaks
# into the frontend `vite build` below, silently flipping the pre-push
# build-check to DEV mode (import.meta.env.DEV=true), so it stops mirroring
# the deploy build (myth-fks7c: the DEV-only transport chunk appeared in the
# pre-push dist while the real prod build correctly excluded it). The
# subshell keeps the env inside gate 5; `set -e` still propagates a
# wiki:check failure.
(
  set -a && . backend/.env.development && set +a
  pnpm wiki:check
)

echo "→ pre-push gate (6/7): dev-tool verifier"
# Only run when the diff touches dev-tool subtree or backend contract
# sources — verify is moderately expensive (JSDOM + per-panel boot) and
# adds no value when the diff doesn't affect the dev-tool surface.
diff_files=$(git diff --cached --name-only origin/main 2>/dev/null || git diff --name-only HEAD)
if echo "$diff_files" | grep -qE '^(backend/dev-tool/|backend/src/contract/(backend-routes|pipeline-routes)\.ts)'; then
  pnpm dev-tool:verify
else
  echo "  (diff doesn't touch dev-tool surface; skipping)"
fi

echo "→ pre-push gate (frontend): lint rails + tests + coverage (diff-scoped)"
# Three-dot range = commits being pushed vs the merge-base with origin/main.
# Mirrors .github/workflows/frontend-check.yml exactly: client-core (contract +
# tokens) → ui (design system: typecheck/lint/css-lint/test/coverage/
# story-coverage) → web (app shell + screen-coverage + storybook build). The
# Playwright overflow sweep stays CI-only. When any gate fails here, fix the
# underlying issue — do NOT bypass with `git push --no-verify`.
fe_files=$(git diff --name-only origin/main...HEAD 2>/dev/null || true)
if echo "$fe_files" | grep -qE '^(frontend/|\.github/workflows/frontend-check\.yml)'; then
  pnpm --filter @mythrun/client-core typecheck
  pnpm --filter @mythrun/client-core lint
  pnpm --filter @mythrun/client-core test
  pnpm --filter @mythrun/client-core test:coverage
  pnpm --filter @mythrun/ui typecheck
  pnpm --filter @mythrun/ui lint
  pnpm --filter @mythrun/ui lint:css
  pnpm --filter @mythrun/ui test
  pnpm --filter @mythrun/ui test:coverage
  pnpm --filter @mythrun/ui story-coverage
  pnpm --filter @mythrun/web screen-story-coverage
  # build-storybook catches story/MDX breakage cheaply; the Playwright overflow
  # sweep (test-storybook) is CI-only — too slow + heavy for pre-push (pushes
  # are expensive). frontend-check.yml runs the full 375/1280 gate.
  pnpm --filter @mythrun/web build-storybook
  pnpm --filter @mythrun/web typecheck
  pnpm --filter @mythrun/web lint
  pnpm --filter @mythrun/web test
  pnpm --filter @mythrun/web test:coverage
  pnpm --filter @mythrun/web build
else
  echo "  (diff doesn't touch frontend; skipping)"
fi
