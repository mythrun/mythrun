{
  "name": "mythrun",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev": "pnpm --filter backend dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:migrate": "pnpm --filter @mythrun/backend db:migrate",
    "wiki:build": "pnpm --filter @mythrun/wiki build",
    "wiki:check": "pnpm --filter @mythrun/wiki check",
    "wiki:accept-drift": "pnpm --filter @mythrun/wiki accept-drift",
    "wiki:dev": "pnpm --filter @mythrun/wiki dev",
    "smoke:staging": "bash backend/scripts/smoke/staging.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "eslint": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "eslint-config-prettier": "^10.1.8"
  }
}
