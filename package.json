{
  "name": "mythrun",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev": "pnpm --filter backend dev",
    "dev:dev-tool": "pnpm --filter @mythrun/dev-tool dev",
    "dev-tool:check": "pnpm --filter @mythrun/backend dev-tool:check",
    "dev-tool:verify": "pnpm --filter @mythrun/dev-tool verify",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:migrate": "pnpm --filter @mythrun/backend db:migrate",
    "wiki:build": "pnpm --filter @mythrun/wiki build",
    "wiki:check": "pnpm --filter @mythrun/wiki check",
    "wiki:accept-drift": "pnpm --filter @mythrun/wiki accept-drift",
    "wiki:dev": "pnpm --filter @mythrun/wiki dev",
    "smoke:staging": "bash backend/scripts/smoke/staging.sh",
    "smoke:ws-transport": "bash backend/scripts/smoke/ws-transport.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:coverage": "pnpm --filter @mythrun/backend test:coverage"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,cjs,mjs,html,yml,yaml,json,md}": "prettier --write"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "prettier": "^3.3.0",
    "typescript-eslint": "^8.15.0"
  }
}
