# Dolt database files (added by bd init)
.dolt/
*.db

# Superpowers brainstorming scratch
.superpowers/
.playwright-mcp/
docker-compose.override.yml

# Local scratch / agent-authored ephemeral files (checklists, reports, etc.)
tmp/

# Agent-authored research artifacts (audits, comparisons) — local-only, not committed.
docs/research/

# Persistent dev-server logs (myth-lmz6). The dev-logged.sh wrapper writes
# pino JSON to backend/logs/dev-YYYY-MM-DD.log; *.log above also covers
# individual files but this scopes the whole directory away.
backend/logs/

# Git worktrees created via `bd worktree create` / `git worktree add` for
# parallel implementation work. Each worktree has its own checked-out tree;
# from the main repo's view they're foreign and must not be tracked.
.worktrees/

# macOS Finder duplicates of docs/wiki/site/ (these accumulate via Finder copy-paste).
docs/wiki/site [0-9]*/

# Beads server lockfile artifacts (transient per-process state)
.beads/dolt-server*.pid
.beads/dolt-server*.port

# Terraform plan files — the `terraform plan -out` artifact, named bare `tfplan`
# OR `*.tfplan`. These MUST be ignored, not merely untracked: the wiki source-hash
# (docs/wiki/build/sourceHash.ts) enumerates `infra/` via `git ls-files --others
# --exclude-standard`, which includes untracked-but-unignored files — so a stray
# `tfplan` under infra/ poisons infra/index.html's hash (present on dev, absent in a
# clean CI checkout → drift). The bare `tfplan` line catches the extensionless name.
tfplan
*.tfplan
