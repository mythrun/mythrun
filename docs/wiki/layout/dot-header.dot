graph [
  bgcolor="#EFE9DC",
  fontname="IBM Plex Mono",
  fontsize=11,
  rankdir=LR,
  margin=0.2,
]
node [
  shape=box,
  style="filled",
  fillcolor="#EFE9DC",
  color="#231B12",
