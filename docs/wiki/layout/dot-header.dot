  fontname="IBM Plex Mono",
  fontsize=11,
  penwidth=1.5,
]
edge [
  color="#231B12",
  fontname="IBM Plex Mono",
  fontsize=10,
  penwidth=1.2,
  arrowsize=0.7,
]
