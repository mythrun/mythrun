digraph live_play {
  // The /campaigns/:id/play keystone. PlayRoute resolves the viewer identity +
  // ownership, then PlaySession runs the start flow: a read-only GET /active probe
  // FIRST (a running session joins silently — no POST, no 409), then POST /start
  // and the classifier — each arm resolves to a different screen. The transient
  // between-sessions codes collapse into ONE waiting phase that backoff-polls
  // /start behind the SessionPreparing hold (no SSE-driven re-start). The `ready`
  // arm mounts SessionShell, the streamed multiplayer transcript over the WS
  // transport view-model (useSession), which folds every frame through the
  // reconnect-safe transcript reducer — including the dm_correction errata row. A
  // second, presentation-only reveal gate (useRollReveal) turns skill_check /
  // dice_roll frames into in-stream RollCards and holds the outcome prose.
  rankdir=TB;
  compound=true;

  route [label="PlayRoute  ·  /campaigns/:id/play\nfullBleed route handle · usePlayViewer\ngetMe + /mine → { userId, isOwner, party }"];
  start [label="PlaySession · useSessionStart\nprobe GET /active FIRST — running ⟹ join (no POST, no 409)\nelse POST /start (the OWNER's credit debits) → classify ↓"];

  subgraph cluster_arms {
    label="the start-flow arms (one screen each)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    waiting [label="409 prep_not_ready / reconcile_pending /\nsession_ending → waiting · PreparingHold\n(SessionPreparing — the calm between-sessions hold)", color="ember", fontcolor="ember"];
    join [label="409 session_already_active\n→ GET /active → sessionId\n(the rare probe↔POST race)"];
    purchase [label="402 insufficient_credits\n→ PurchaseSeam\nowner buy · member hold"];
    blocked [label="409 members_without_characters (names WHO waits) /\ncampaign_not_active / off-contract\n→ calm manual-retry notice"];
  }

  shell [label="SessionShell  (ready{sessionId})\nuseSession over ws-session-client\nconnect(seedLastSeq: 0) — full replay"];

  subgraph cluster_shell {
    label="the live stage";
    style="dashed";
    color="ember";
    fontcolor="ember";

    reducer [label="reduceFrameReconciling\ntranscript reducer + own-echo FIFO reconcile\n+ turnId whole-turn replace", color="ember", fontcolor="ember"];
    stream [label="MessageStream\nDmMessage (serif, streams) · PlayerMessage (mono)\nskill_check/dice_roll → RollCard · dm_correction → errata slip\nother mechanical → mono line"];
    reveal [label="useRollReveal · buildRevealView\ndice moment: phase (idle→revealed→released)\n+ gatedTurnIds (outcome prose held) — no wire frame", color="ember", fontcolor="ember"];
    presence [label="out-of-band presence\nThinkingIndicator · typing · connection line"];
    input [label="SessionInput\nsend · @dm explicit-text summon"];
  }

  subgraph cluster_knowledge {
    label="the knowledge layer (MYT-94) — only what the character knows";
    style="dashed";
    color="ember";
    fontcolor="ember";

    cache [label="usePlayKnowledge · useKnowledgeCache\nONE member snapshot → wiki + graph + entity index\nboundary-only refetch · no frame promotes it", color="ember", fontcolor="ember"];
    sidebar [label="KnowledgePanel · KnowledgeSidebar\n~30% rail (desktop) / Drawer (narrow)\nWorld Wiki · Relationship Graph (drained) · Character Sheet"];
    sheet [label="useSessionSheet · reduceLedger\ncurated sheet + live HP/condition overlay\n(ledger_update — authoritative SET)", color="ember", fontcolor="ember"];
  }

  recap [label="session_end → /campaigns/:id/recap\n(stub route — the recap read is a filed bead)"];
  nochar [label="failed{no_character} (transport closed 4404)\n→ NoCharacterNotice · CTA → create (myth-mnik3)"];

  route -> start;
  start -> waiting;
  start -> join;
  start -> purchase;
  start -> blocked;
  start -> shell [label="200 (or an /active hit)"];
  join -> shell [style="dotted"];
  waiting -> start [style="dotted", label="backoff-poll /start\n2s→4s→8s→~12s + jitter"];
  shell -> reducer [lhead=cluster_shell];
  reducer -> stream [style="invis"];
  reducer -> reveal [style="invis"];
  reveal -> presence [style="invis"];
  reducer -> input [style="invis"];
  shell -> cache [lhead=cluster_knowledge, label="on ready"];
  cache -> sheet [style="invis"];
  sheet -> sidebar [style="invis"];
  cache -> stream [label="entity highlight\n(settled prose)", style="dotted", constraint=false];
  shell -> recap [ltail=cluster_shell, label="ended"];
  shell -> nochar [ltail=cluster_shell, label="no character (4404)"];
}
