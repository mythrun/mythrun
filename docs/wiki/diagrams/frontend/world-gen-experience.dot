digraph frontend_world_gen_experience {
  // The player-facing world-generation experience (MYT-89): the phase-aware
  // /campaigns/:id route drives a two-act generation (loading screen → live
  // fog+graph) that flips to the browsable reveal the moment the world's
  // introduction page is written (right after connections weave), while the
  // pipeline's tail runs silently behind it. Mirrors the design-system split — a
  // DOM-free client-core brain (the fog fluid sim, the force graph, the SSE fold,
  // the wiki normalizer) rendered by @mythrun/ui Canvas/DOM, composed by the web
  // route. The reveal plays a one-time moment (RevealTransition). The backend
  // pipeline + SSE surface are other pages.
  compound=true;

  subgraph cluster_web {
    label="@mythrun/web  (the route)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    route [label="CampaignDetailRoute\n/campaigns/:id · phase-aware\nfold stream · fetch timings once ·\nreveal at world_introduction"];
    act1 [label="GeneratingView · act one\nWorldGenLoading (spinner +\n20 cycling flavor lines + countdown)\n→ watch beat"];
    act2 [label="GeneratingView · act two\nFullBleedStage → WorldGenGraph\ngated (inert) · status card / footer"];
    moment [label="RevealTransition\nthe one-time moment\nhold → gust → settle → resolve → done"];
    rev [label="WorldReveal\ndesktop 50/50 graph|wiki ·\nmobile graph + Drawer sheet\nopens on the introduction ·\nshared selection · silent refetch"];
  }

  subgraph cluster_cc {
    label="@mythrun/client-core/worldgen  (the brain · DOM-free · R1)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    stream [label="useWorldGenStream\nSSE fold → nodes/edges + stages ·\nconnectionsDone · completedTailStageCount"];
    fogsim [label="FogSim\nfluid sim: wind + doublets +\nBayer density · fixed-timestep · pure"];
    force [label="ForceSim (d3-force)\ncontained · box-collision · clustering ·\ndisplayId identity"];
    space [label="virtual-space + camera\nvirtual coords · pannable mobile world"];
    wikivm [label="toWikiViewModel\nsnapshot → intro + groups + RELATED"];
    eta [label="remainingWaitMs\ntimings ∩ live stages → countdown"];
  }

  subgraph cluster_ui {
    label="@mythrun/ui  (the render · Canvas + DOM)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    fogfield [label="WorldGenFogField\nfog canvas (behind)"];
    gcanvas [label="WorldGenGraph\ngraph canvas (front) · penstroke edges ·\ntrace-then-stamp arrival · drag"];
    card [label="WorldGenStatusCard\noverlay | footer · fixed bars + countdown"];
    wiki [label="WorldWiki\nintro home + entity pages ·\nRELATED + search + back-nav"];
    drawer [label="Drawer\nmobile edge-handle wiki sheet ·\nmount-persistent"];
  }

  api [label="API  (other pages)\nSSE status stream ·\nGET /api/worldgen/stage-timings ·\nGET .../world-snapshot (known-tier +\nintroduction · 409 until world_introduction)", color="ember", fontcolor="ember"];

  route -> stream [style="dotted"];
  route -> act1;
  route -> act2 [label="watch"];
  route -> moment [label="intro written"];
  moment -> rev [label="the moment"];
  act2 -> gcanvas;
  act2 -> card [style="dotted"];
  rev -> gcanvas;
  rev -> wiki;
  rev -> drawer [label="mobile", style="dotted"];
  drawer -> wiki [label="hosts", style="dotted"];
  gcanvas -> fogfield [label="layered", style="dotted"];
  gcanvas -> force [style="dotted"];
  gcanvas -> space [style="dotted"];
  fogfield -> fogsim [style="dotted"];
  card -> eta [style="dotted"];
  wiki -> wikivm [style="dotted"];
  stream -> api [label="SSE fold"];
  route -> api [label="timings + snapshot"];
}
