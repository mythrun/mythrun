digraph frontend_app_shell {
  // The application skeleton, built to port to true-native later. The wire
  // contract (@mythrun/contract — Zod REST schemas) is the SINGLE typed source:
  // the backend types its handler returns against it; the client brain VALIDATES
  // responses against it at runtime. @mythrun/client-core (DOM-free) owns every
  // backend call (defineEndpoint → suspense hooks), the four-state session store,
  // the in-memory access-token manager + single-flight 401 refresh-retry, the
  // OAuth/PKCE sign-in helper + session adapter, the platform-capability
  // interfaces, and the i18n catalog. @mythrun/web is THIN: the router shell, the
  // quiet frame, the live OAuth auth screens (signin · callback · onboard) + thin
  // route stubs + the wired home hub, and the web IMPLEMENTATIONS of the platform
  // interfaces. The SPA is cross-origin to the API (real CORS, not a dev proxy);
  // the backend BFF mints the access token + the httpOnly mythrun_refresh cookie.
  // Dependency direction: contract ← {backend, client-core} ← ui ← web.
  compound=true;

  subgraph cluster_contract {
    label="@mythrun/contract  (BUILT package · zod · the typed wire)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    rest [label="REST Zod schemas\nMeResponse · CampaignSummary\nISO-string wire dates ·\n/me public projection"];
    events [label="realtime event unions\nsession · pipeline\n(TS, not Zod — MYT-85)"];
  }

  backend [label="@mythrun/backend\ntypes handler returns (tsc) · real CORS · one origin\nBFF: /auth/session + /auth/refresh\n(access token + httpOnly mythrun_refresh cookie)", color="ember", fontcolor="ember"];

  subgraph cluster_cc {
    label="@mythrun/client-core  (the client brain · DOM-free · R1)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    endpoint [label="defineEndpoint — the ONLY call path\nvalidates response → typed data\n401 → single-flight refresh → retry once\nHttpError · ContractValidationError · NetworkError"];
    hooks [label="slice hooks (React-Query suspense)\nuseMe · useMyCampaigns"];
    brain [label="session store (4-state + suspended) ·\nin-memory token mgr + runRefresh ·\nOAuth/PKCE helper + session adapter ·\nSecureStorage · OAuthStateStore ·\ngetAuthHeaders · i18n catalog"];
    endpoint -> hooks [style="dotted"];
  }

  subgraph cluster_web {
    label="@mythrun/web  (THIN: shell + screens + web impls)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    shell [label="app shell\nrouter · RequireAuth (4-state → splash) ·\nsticky quiet frame (StickyBar · header menu) ·\ndithered 404 · typed-error boundary"];
    home [label="routes/ — OAuth auth screens\n(signin · callback · onboard) ·\nthin stubs + the wired home hub"];
    webimpl [label="platform/web\nSecureStorage → localStorage ·\nOAuthStateStore → sessionStorage · redirectTo ·\nuseScrollElevation → IntersectionObserver"];
  }

  rest -> backend [label="z.infer types (tsc)"];
  rest -> endpoint [label="validates\nresponses", lhead=cluster_cc];
  events -> backend [style="dotted", label="re-export shim"];
  hooks -> home [label="screens use\nclient-core hooks only (R5)", lhead=cluster_web];
  brain -> webimpl [style="dotted", label="interface ← web impl\n(injected at provider root)"];
  home -> backend [label="fetch · cross-origin → CORS", style="dashed", constraint=false];
}
