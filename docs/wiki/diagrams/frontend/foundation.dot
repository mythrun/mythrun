digraph frontend_foundation {
  // The frontend foundation: two workspace packages and the lint rails that
  // gate feature code before any UI is built. @mythrun/web (feature/route code)
  // consumes @mythrun/ui as SOURCE through the exports map. Feature code under
  // src/** must pass two rails — no ad-hoc UI, no hardcoded strings — enforced
  // identically by the frontend-check CI workflow and the diff-scoped pre-push
  // section. The library zone (frontend/ui/**) is exempt: raw elements live there.
  rankdir=LR;
  compound=true;

  subgraph cluster_ws {
    label="frontend workspace";
    style="dashed";
    color="ember";
    fontcolor="ember";

    web [label="@mythrun/web\nfrontend/src/**\n(features · routes)", color="ember", fontcolor="ember"];
    ui  [label="@mythrun/ui\nfrontend/ui/src/**\n(<Text> anchor;\nlibrary zone)"];
    web -> ui [label="import { Text }\n(source via exports map,\nmoduleResolution: Bundler)"];
  }

  subgraph cluster_rails {
    label="lint rails (error on src/**)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    adhoc [label="mythrun-ui/no-ad-hoc-ui\n(custom rule)\nno raw <div> · style · className"];
    i18n  [label="i18next/no-literal-string\n(jsx-only: text + attrs)"];
    hatch [label="escape hatch\nreportUnusedDisableDirectives\n+ require-description"];
  }

  subgraph cluster_gates {
    label="gates (Rule 3)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    ci   [label="frontend-check.yml\n(always-on required check)\ntypecheck·lint·test·coverage·build"];
    hook [label=".husky/pre-push\n(diff-scoped on\norigin/main...HEAD)"];
  }

  web -> adhoc [lhead=cluster_rails, label="src/** lint"];
  ui  -> adhoc [style="dotted", label="no-ad-hoc-ui OFF\n(jsx-a11y ON)"];

  adhoc -> ci   [ltail=cluster_rails, lhead=cluster_gates];
  i18n  -> hook [style="invis"];
}
