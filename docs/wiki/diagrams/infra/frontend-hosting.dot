digraph frontend_hosting {
  // Gated static SPA hosting at staging.mythrun.com. A laptop hits Route 53,
  // which aliases (A + AAAA) to a CloudFront distribution. The DEFAULT behavior
  // runs a viewer-request Basic-Auth function BEFORE the cache — it reads the
  // expected header from a KeyValueStore and fails closed to 401. On a match the
  // function ALSO rewrites extension-less paths to /index.html so SPA deep links
  // resolve, then the request flows through the cache to a PRIVATE S3 bucket over
  // Origin Access Control (SigV4). The /api/* behavior is the same-origin API
  // proxy (MYT-84): it skips the gate (the API self-auths) — so its real API
  // 403/404s are never rewritten into the SPA shell — and forwards to the API
  // origin with Host rewritten, so the BFF refresh cookie is first-party. The
  // Deploy Frontend workflow syncs the built dist/ in and invalidates index.html.
  rankdir=LR;
  compound=true;

  laptop [label="laptop\nBasic-Auth\nuser : pass", color="ember", fontcolor="ember"];
  dns    [label="Route 53\nstaging.mythrun.com\nA + AAAA alias"];
  cert   [label="*.mythrun.com\nwildcard cert\n(DNS module)"];

  subgraph cluster_cf {
    label="CloudFront distribution  (PriceClass_100)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    gate  [label="default behavior\nviewer-request fn\nBasic-Auth gate (→ 401)\n+ SPA route rewrite\next-less → /index.html", color="ember", fontcolor="ember"];
    kvs   [label="KeyValueStore\nstaging-basic-auth\n(set out-of-band)"];
    cache [label="CachingOptimized\n(Authorization not\nin cache key)"];
    apibehav [label="/api/* behavior\nCachingDisabled\nAllViewerExceptHost\nNO gate fn"];
  }

  oac   [label="Origin Access Control\nSigV4, signing=always"];
  api   [label="API origin\nstaging-api.mythrun.com\nself-auths (JWT)", color="ember", fontcolor="ember"];

  subgraph cluster_s3 {
    label="private S3  mythrun-staging-frontend";
    style="dotted";

    bucket [label="public-access-block\nbucket policy:\nGetObject only,\nSourceArn = distribution"];
  }

  deploy [label="Deploy Frontend\nworkflow", color="ember", fontcolor="ember"];

  laptop -> dns    [label="https"];
  dns    -> gate    [label="default\n(gated)"];
  dns    -> apibehav [label="/api/*\n(gate-exempt)"];
  cert   -> dns    [label="TLS", style=dashed];
  gate   -> kvs    [label="kvs.get()"];
  gate   -> cache  [label="match → pass"];
  cache  -> oac;
  oac    -> bucket [label="GetObject\nSigV4"];
  apibehav -> api  [label="proxy\nHost rewritten"];
  deploy -> bucket [label="s3 sync dist/"];
  deploy -> cache  [label="invalidate\n/index.html", style=dashed];
}
