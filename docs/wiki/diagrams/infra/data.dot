digraph data {
  rankdir=LR;

  subgraph cluster_private {
    label="private subnets";
    style="dashed";
    color="ember";
    fontcolor="ember";

    rds   [label="RDS Postgres 16\ndb.t4g.micro  Single-AZ\n20 GB gp3"];
    redis [label="ElastiCache Redis 7.1\ncache.t4g.micro\nsingle node"];
  }

  master_secret  [label="AWS-managed\nRDS master secret\n(mythrun_admin)"];
  redis_secret   [label="mythrun/shared/\nredis-auth"];
  staging_secret [label="mythrun/staging/\nrds-password"];
  prod_secret    [label="mythrun/production/\nrds-password"];

  bootstrap [label="bootstrap-\ndatabases.sh", color="ember", fontcolor="ember"];

  rds -> master_secret [label="auto-created"];

  bootstrap -> master_secret  [label="read"];
  bootstrap -> rds            [label="CREATE DATABASE\nCREATE USER"];
  bootstrap -> staging_secret [label="write"];
  bootstrap -> prod_secret    [label="write"];

  redis -> redis_secret [label="AUTH token"];
}
