digraph repository {
  // The repository layer: a closure-based factory over a single pg.Pool that
  // returns one namespace object per top-level table cluster. Routes, services,
  // and workers call repo.<namespace>.<method>; the namespace functions own the
  // SQL, the parameter binding, and the snake_case→camelCase mapping.
  rankdir=LR;
  compound=true;
  nodesep=0.4;
  ranksep=0.7;

  subgraph cluster_callers {
    label="callers";
    style="dashed";
    color="ember";
    fontcolor="ember";

    routes  [label="Fastify routes\n(users, invites,\nbilling, requireOnboarded)"];
    webhook [label="Stripe webhook\ndispatcher\n(open tx → handlers)"];
    workers [label="BullMQ workers\n(prep, scribe — future)"];
  }

  subgraph cluster_factory {
    label="createRepo(pool)  (backend/src/repo/index.ts)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    users     [label="users.ts\ncreate, getById,\ngetByCognitoSub,\ngetByCognitoSubWithTimeout,\ngetByUsername, update"];
    worlds    [label="worlds.ts\ncreate, getById,\ngetDemo, listByUser,\nupdate, updateStatus,\nincrementForkCount"];
    camps     [label="campaigns.ts\ncreate, getById,\nlistByUser, update,\naddMember, getMembership,\ngetOwner, listMembers"];
    sessions  [label="sessions.ts\ncreate, getById,\ngetActiveByCampaign,\nlistByCampaign,\nupdate, recordUsage,\nbudgetSummary"];
    credits   [label="credits.ts\nbalance, grant,\natomicDebit (returns\nconsumedSourceType),\ntryDebitForSession,\nlistEntries\n(users-row lock)\n+ grantInTx (trial-burn) +\nrecordClawback (standalone)"];
    invites   [label="invites.ts\ncreate, getByCode,\ngetCodePreview,\nlistForCampaign,\nrevoke, acceptInvite\n(load-bearing tx)"];
  }

  subgraph cluster_billing_ns {
    label="billing namespaces  (transaction-scoped, ClientLike)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    se   [label="stripe-events.ts\nrecordOrSkip\n(idempotency)"];
    pur  [label="purchases.ts\ninsertMany,\ngetByPaymentIntent,\nmarkRefunded"];
    us   [label="user-subscriptions.ts\nupsertFromStripe\n(strict-> stale filter),\nmarkCanceled,\ngetActiveForUser"];
    bh   [label="billing-history.ts\nappend, find,\nlistByUser (cursor),\nmarkRefunded"];
  }

  subgraph cluster_seams {
    label="shared seams";
    style="dotted";

    uuid    [label="uuidv7.ts\nuuidv7(): string"];
    uuid5   [label="uuidv5.ts\nuuidv5(name, ns)\n(trial-burn source_id)"];
    types   [label="types.ts\nUser, World,\nCampaign, Session,\nCampaignMember,\nCampaignInvite\n+ Update inputs"];
    mappers [label="mappers.ts\nsnake → camel\nnarrowing helpers"];
  }

  pool   [label="pg.Pool\n(boot-gate path)\nor stub Pool\n(fallback path)", color="ember", fontcolor="ember"];
  db     [label="Postgres\nusers, worlds,\ncampaigns, sessions,\ncampaign_members,\ncampaign_invites,\ncredit_ledger", color="ember", fontcolor="ember"];

  routes  -> users    [label="repo.users.create\n.getByCognitoSubWithTimeout"];
  routes  -> worlds   [label="repo.worlds.…"];
  routes  -> credits  [label="repo.credits.atomicDebit"];
  routes  -> invites  [label="repo.invites.acceptInvite\n.create / .revoke"];
  routes  -> camps    [label="repo.campaigns.\nlistMembers / addMember"];
  routes  -> us       [label="userSubscriptions.\ngetActiveForUser"];
  routes  -> bh       [label="billingHistory.\nlistByUser"];
  webhook -> se       [label="recordOrSkip"];
  webhook -> pur      [label="insertMany /\nmarkRefunded"];
  webhook -> us       [label="upsertFromStripe /\nmarkCanceled"];
  webhook -> bh       [label="append /\nmarkRefunded"];
  webhook -> credits  [label="grantInTx /\nrecordClawback"];
  workers -> camps    [label="repo.campaigns.…"];
  workers -> sessions [label="repo.sessions.…"];

  users    -> uuid    [label="id =", style=dashed];
  worlds   -> uuid    [label="", style=dashed];
  camps    -> uuid    [label="", style=dashed];
  sessions -> uuid    [label="", style=dashed];
  credits  -> uuid    [label="", style=dashed];
  credits  -> uuid5   [label="trial-burn\nsource_id", style=dashed];
  invites  -> uuid    [label="", style=dashed];

  users    -> mappers [label="toUser", style=dashed];
  worlds   -> mappers [label="toWorld", style=dashed];
  camps    -> mappers [label="toCampaign\ntoCampaignMember", style=dashed];
  sessions -> mappers [label="toSession", style=dashed];
  credits  -> mappers [label="toCreditEntry", style=dashed];
  invites  -> mappers [label="toCampaignInvite", style=dashed];

  users    -> pool    [label="pool.query\nINSERT … RETURNING *\nUPDATE … COALESCE\nSELECT …"];
  worlds   -> pool    [label=""];
  camps    -> pool    [label=""];
  sessions -> pool    [label=""];
  credits  -> pool    [label="BEGIN; SET LOCAL …\nSELECT … FOR UPDATE\nINSERT;  COMMIT"];
  invites  -> pool    [label="BEGIN; lock invite\nmembership-first;\nexpiry; cap; INSERT;\nuses++; COMMIT"];

  pool    -> db       [label="parameterized SQL"];
  se   -> db [label="webhook tx", style=dashed];
  pur  -> db [label="", style=dashed];
  us   -> db [label="", style=dashed];
  bh   -> db [label="", style=dashed];

  types -> users    [label="", style=dotted];
  types -> worlds   [label="", style=dotted];
  types -> camps    [label="", style=dotted];
  types -> sessions [label="", style=dotted];
  types -> credits  [label="", style=dotted];
  types -> invites  [label="", style=dotted];
}
