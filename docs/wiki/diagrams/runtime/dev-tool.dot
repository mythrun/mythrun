digraph dev_tool {
  // The dev tool shell. A throwaway, local-only engineering UI. The
  // sidebar drives 6 entity-scoped workflow pages; each page composes
  // multiple single-purpose panel mount fns into a scrolling column.
  // Header chrome (always-on health pip + active-campaign dropdown)
  // sits above the banner; a persistent right-side drawer owns the
  // sole EventSource for the active campaign. The ship gate
  // (pnpm dev-tool:check) plus a registry invariant test keep
  // coverage honest.
  rankdir=LR;
  compound=true;
  nodesep=0.4;
  ranksep=0.7;

  browser [label="browser\n127.0.0.1:5273", color="ember", fontcolor="ember"];

  subgraph cluster_shell {
    label="src/shell/  (composition root)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    chrome       [label="header-chrome.ts\nhealth pip (5s) +\nactive-campaign\ndropdown (10s)"];
    sidebar      [label="sidebar.ts\n6 workflow leaves\nCampaigns / World /\nCharacters / Users /\nBilling / System"];
    banner       [label="banner.ts\nactive-campaign\nanchor + live\nstage label"];
    mainPane     [label="mainPane\nmounts one workflow\npage at a time\n(unmount on switch)"];
    drawer       [label="drawer/drawer.ts\nwire-log + pause /\nclear / export"];
    activeCamp   [label="active-campaign.ts\nshell-owned store\nget/set + subscribe"];
    identityBr   [label="identity-bridge.ts\nsingle listener for\nmythrun.identitychanged"];
    workflowReg  [label="workflow-registry.ts\nWORKFLOWS list +\ngetWorkflowMount"];
  }

  subgraph cluster_pages {
    label="src/pages/  (one composer per workflow)";
    style="dashed";

    pages [label="6 page composers\ncampaigns / world /\ncharacters / users /\nbilling / system\n(each mounts N\npanels inline)"];
    pageShared [label="_shared/\npage-skeleton.ts\nbuildPageBody +\nmountSection"];
  }

  subgraph cluster_drawer_internals {
    label="drawer internals";
    style="dotted";

    subs   [label="subscriptions.ts\nsole EventSource owner\none ES per active id"];
    bus    [label="event-bus.ts\nin-process pub/sub"];
    buffer [label="buffer.ts\n500-event FIFO ring"];
  }

  subgraph cluster_panels {
    label="src/components/  (single-purpose panels)";
    style="dashed";

    panels [label="40+ panel modules\nmountXxxPanel\nPanelHandle = { root, unmount }\ndomain renderers:\nhierarchy tree /\nrandom tables /\ncharacter sheet"];
    shared [label="components/_shared/\npanel-skeleton.ts\nerror-block.ts\njson-disclosure.ts\nprogress-strip.ts"];
  }

  subgraph cluster_gate {
    label="ship gate + registry invariants";
    style="dotted";

    contracts [label="backend/src/contract/\nbackend-routes.ts\npipeline-routes.ts\npipeline-events.ts\npipeline-jobs.ts"];
    coverage  [label="backend/dev-tool/\ncoverage.json\n{ routes, events, jobs,\n  exempt: { reasons ≥ 20 } }"];
    check     [label="dev-tool-check.ts\n+ verify-registry.test.ts\n(PAGE_REGISTRY +\nPANEL_EXERCISES,\n4 invariants)"];
    ci        [label=".github/workflows/\ndev-tool-check.yml"];
  }

  vite    [label="vite.config.ts\nproxy /api/* + /health/*"];
  api     [label="src/api-client.ts\napiCall + sse-client\nstamps x-mythrun-dev-sub"];
  backend [label="local backend\nlocalhost:3000 (PORT)", color="ember", fontcolor="ember"];

  // Browser → shell mount
  browser -> chrome [label="page load →\nmountShell"];
  chrome -> banner [label="above (always-on)", style=dotted];
  sidebar -> mainPane [label="leaf click →\nselectWorkflow(mountFn)"];
  workflowReg -> sidebar [label="WORKFLOWS"];
  pages -> mainPane [label="page mount →\nPanelHandle", style=dashed];
  pageShared -> pages [style=dotted, label="buildPageBody"];
  pages -> panels [label="compose N\nmountXxxPanel", style=dashed];
  shared -> panels [style=dotted, label="reused split-view\n+ error / JSON / progress"];

  // Active-campaign fan-out
  activeCamp -> chrome [label="dropdown selection"];
  activeCamp -> banner [label="onActiveCampaignChanged"];
  activeCamp -> sidebar [label="dims requiresCampaign\nleaves when null"];
  activeCamp -> subs [label="auto-subscribe on set"];

  // Identity bridge
  identityBr -> activeCamp [label="re-subscribe", style=dashed];

  // Drawer internals
  subs -> bus [label="onmessage → publish"];
  bus -> buffer [label="push"];
  bus -> drawer [label="render rows"];
  bus -> banner [label="live stage label\n(phase / stage-*)", style=dashed];

  // HTTP path
  panels -> api [label="apiCall(...)", style=dashed];
  api -> vite [label="x-mythrun-dev-sub: dev-user-N"];
  vite -> backend [label="proxied"];
  subs -> vite [label="EventSource\n/api/campaigns/:id/\nstatus/stream"];

  // Ship gate path
  contracts -> check [label="read at boot"];
  coverage -> check [label="read at boot"];
  check -> ci [label="pnpm dev-tool:check", style=dashed];
}
