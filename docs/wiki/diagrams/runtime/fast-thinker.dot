digraph fast_thinker {
  // The FastThinker — the real player-facing prose tier (Sonnet). The
  // SessionController calls render(ctx, emit); the FT drives an interleaved
  // tool loop via streamTextWithTools (the ai.ts wrapper over the Vercel AI
  // SDK). It consumes fullStream in part order — text deltas stream out as
  // text frames; a tool-call resolves through a pure resolver (roll_dice /
  // roll_skill_check / the three world-knowledge lookups), whose RESULT is fed
  // back to the model as a constraint and emitted as a skill_check / dice_roll
  // frame from the consume loop (the single emission point). roll_skill_check
  // runs the Principle #5 flow: a Haiku DC table → deterministic d20
  // (crypto.randomInt) → matched outcome tier as the constraint. The
  // world-knowledge lookups run gate → resolve → ST-vet → relay: the secret
  // sd_playbook is captured INSIDE the opaque vet closure and never crosses
  // back to the FT. The resolve step also merges the in-session working set
  // (MYT-73 read-after-write) and a relay/invent records an injection back into
  // it. After its prose the FT appends a [[WORLD_DELTA]] fact-delta a dual-sink
  // guard strips from BOTH the player stream AND the transcript. The cap stops
  // the loop after N steps.
  rankdir=TB;
  compound=true;
  nodesep=0.4;
  ranksep=0.7;

  ctx [label="FtTurnContext (public-by-construction)\nftContext · ftHistory · participants ·\nstandingDirective (behavior-bound)\n(no plot/secret field has anywhere to live)", color="ember", fontcolor="ember"];

  subgraph cluster_ft {
    label="SonnetFastThinker.render(ctx, emit)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    build [label="buildModelMessages\nsystem (ft-system.txt) + full transcript\nsliding cache breakpoints (§3.9)\n+ standing directive as raw post-breakpoint tail"];
    loop  [label="streamTextWithTools (Sonnet)\nstopWhen stepCountIs(FT_MAX_TOOL_STEPS)\nprepareStep → final-step prose close"];
    consume [label="consume fullStream IN PART ORDER\n(the SINGLE emission point)\nerror/abort parts → throw", color="ember", fontcolor="ember"];
    guard [label="WorldDeltaGuard (dual-sink)\nstrip \\n[[WORLD_DELTA]] section from\nBOTH live emit AND transcript;\ncapture JSON → worldDelta", color="ember", fontcolor="ember"];
  }

  subgraph cluster_tools {
    label="ft-tools.ts  —  pure resolvers (data only, never emit)";
    style="dotted";
    dice  [label="roll_dice\nrollDice(count, sides)\n(crypto.randomInt — Principle #4)"];
    skill [label="roll_skill_check → skill-check.ts\nresolve roller (session_participants)\n→ modifier (per-skill level, expertise)\n→ Haiku DC table → d20 → tier"];
    lookup [label="search_lore / characters_known_to / faction_tree\n→ runWorldFactLookup (orchestrator)"];
  }

  subgraph cluster_flow {
    label="world-fact-lookup  —  gate → resolve → ST-vet → relay (fail-soft)";
    style="dotted";
    color="ember";
    fontcolor="ember";

    gate [label="world-lookup-gate (Haiku)\ncontextual DC over PUBLIC standing only\nauto_success | d20 vs DC → pass/fail"];
    resolve [label="resolver (world-store retrieval)\nover-pull ALL tiers, tier-annotated\n∪ working set (cosine vs query vec)\n[claim by NPC] keeps attribution"];
    vet [label="ST-vet (Opus) — the ONE tier-safety gate\nholds sd_playbook · redactRawText\nrelay | none | invent → player-safe text", color="ember", fontcolor="ember"];
  }

  emit [label="TurnEmitter\nemitText / emitSkillCheck / emitDiceRoll\n(worker-latched → PUBLISH frames)", color="ember", fontcolor="ember"];
  ws [label="working set (Scribe)\nsession:{cId}:workingset\nread-after-write", color="ember", fontcolor="ember"];

  ctx -> build;
  build -> loop;
  loop -> consume [label="fullStream parts"];

  consume -> skill [label="tool-call", style=dashed];
  consume -> dice  [label="tool-call", style=dashed];
  consume -> lookup [label="tool-call", style=dashed];
  skill -> consume [label="constraint\n(fed back to model)"];
  dice  -> consume [label="result"];

  lookup -> gate [label="pass?"];
  gate -> resolve [label="pass /\nauto_success"];
  ws -> resolve [label="∪ read-merge", style=dashed, color="ember"];
  resolve -> vet [label="over-pulled\n(secrets included)"];
  vet -> lookup [label="relay text ONLY\n(no playbook, no raw pull)", color="ember", fontcolor="ember"];
  lookup -> ws [label="record injection\n(vetted relay + tier)", style=dashed, color="ember"];
  lookup -> consume [label="{ result, skill_gate, roll_hidden }\n(data only)"];

  consume -> guard [label="text-delta"];
  guard -> emit [label="pre-delimiter prose only"];
  consume -> emit [label="skill_check / dice_roll"];
}
