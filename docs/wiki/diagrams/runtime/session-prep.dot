digraph session_prep {
  // Session prep — MYT-61 + MYT-62 + MYT-63 + MYT-101 + myth-vb2ov/myth-8mom0.
  // The four-route HTTP plugin (routes/session-preps.ts, MYT-63) is the enqueue
  // + CRUD surface: trigger (owner) adds one 'session-prep' job per
  // (campaign, session_number) on the dedicated session-prep queue, jobId
  // sp-{campaignId}-{sessionNumber}; list/read (member) return a SafeSessionPrep
  // projection that OMITS sd_playbook (the HTTP enforced-ignorance gate — an
  // explicit field literal, not a spread, since there are no Fastify response
  // schemas); reset (owner) deletes the prep row + re-arms the stage in one
  // transaction.
  // The processor claims the per-session pipeline_runs row
  // (stage='session-prep:{n}'), publishes prep-started, resolves the campaign's
  // world, serializes it — TIERED above 40 entities (myth-vb2ov): full detail
  // for the session working set (party + handoff-named + 1-hop neighbors), a
  // one-line dormant roster for the rest — and runs generateSessionPrep (one
  // Opus streamObject producing ft_context + sd_playbook + opening) under an
  // in-prompt OUTPUT BUDGET, ceiling pinned to OPUS_MAX_OUTPUT_TOKENS (128k
  // backstop). finishReason:'length' → one tighter-budget retry, then a
  // {terminal:true} fail. The opening is vetted against this generation's own
  // sd_playbook (runSecretTripwire) BEFORE the insert; the three docs persist
  // to session_preps (ON CONFLICT DO NOTHING); the run is marked completed WITH
  // recorded cost (no cost cap — the routine bound is the prompt budget, the
  // 128k cap is the backstop). A prep failure marks the run failed + publishes
  // prep-failed but DELIBERATELY never flips campaigns.status — session-scoped,
  // resumable.
  //
  // MYT-62: the stream feeds TWO channels. PHASE events (prep-started/ready/
  // failed) ride the player-facing pipeline:campaign: channel — the only signal
  // a player sees. PROSE deltas (prep-delta) ride a SEPARATE prep:campaign:
  // channel served by a dev-only route registered only under AUTH_MODE=bypass
  // (absent in prod). The split IS the enforced-ignorance control: sd_playbook
  // prose can carry secrets and never reaches a player surface.
  rankdir=LR;
  compound=true;
  nodesep=0.4;
  ranksep=0.7;

  subgraph cluster_http {
    label="HTTP surface  routes/session-preps.ts (MYT-63)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    trigger [label="POST /session-prep  (owner)\n202 — always enqueue\n(idempotent: fixed jobId)", color="ember", fontcolor="ember"];
    reads   [label="GET /session-preps[/:prepId]  (member)\ntoSafeSessionPrep(row)\n→ id, sessionNumber, ftContext,\n  snapshotId, createdAt\n  (NO sd_playbook)", color="ember", fontcolor="ember"];
    reset   [label="POST /reset-prep  (owner)\nrepo.transaction:\n  deleteFor + resetStage", color="ember", fontcolor="ember"];
  }

  subgraph cluster_redis {
    label="Redis";
    style="dotted";

    queue   [label="BullMQ queue\nsession-prep\njobId: sp-{campaignId}-\n  {sessionNumber}\nattempts 2, exp backoff 30s", color="ember", fontcolor="ember"];
    phase_ch [label="{redisKeyPrefix}\npipeline:campaign:{id}\n\nPHASE channel (player-safe)\nprep-started / prep-ready /\n  prep-failed", color="ember", fontcolor="ember"];
    prose_ch [label="{redisKeyPrefix}\nprep:campaign:{id}\n\nPROSE channel (dev-only)\nprep-delta (sd_playbook\n  may carry secrets)", color="ember", fontcolor="ember"];
  }

  subgraph cluster_worker {
    label="session-prep Worker  (concurrency 3)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    claim [label="session-prep-processor.ts\natomicClaimStage(kind:'campaign',\n  campaignId,\n  stage='session-prep:{n}')\n'completed' → no-op\n'lost-race' → return", color="ember", fontcolor="ember"];

    started [label="publishEvent\n  ('prep-started')", color="ember", fontcolor="ember"];

    subgraph cluster_generate {
      label="generation — OUTSIDE any txn";
      style="dotted";

      resolve [label="campaigns.getWorldId\n  (campaign → world_id)"];
      serialize [label="serialize-world-state-\n  for-prep.ts\nomniscient, all access tiers\n>40 entities → TIERED:\n  working set FULL (party +\n  handoff-named + 1-hop,\n  cap 60); dormant → 1-line\n  roster (cap 100 + tally)\n≤40 → full dump, unchanged"];
      llm [label="generateSessionPrep\n  model: Opus, streamObject\n  { ft_context, sd_playbook,\n    opening }\n  in-prompt OUTPUT BUDGET\n  (<6k words total)\n  cap OPUS_MAX_OUTPUT_TOKENS\n  (128k backstop)\n  timeout 9 min\n  onProseDelta(field, text)\n  logs session_prep.usage"];
    }

    vet [label="runSecretTripwire(opening)\n  vs THIS generation's\n  sd_playbook (MYT-101)\nbreach → non-terminal fail\n  (nothing persisted)"];

    persist [label="sessionPreps.insert\nINSERT session_preps\n  ON CONFLICT\n  (campaign_id, session_number)\n  DO NOTHING"];
    mark [label="markStageCompleted\npipeline_runs='completed'\ncost_usd = computeCostUsd\n  (recorded, NOT capped)\npublishEvent('prep-ready')", color="ember", fontcolor="ember"];

    fail [label="catch: markStageFailed\npublishEvent('prep-failed',\n  terminal)\nNO campaigns.setFailed\n  (session-scoped)\nnon-terminal → rethrow"];
  }

  subgraph cluster_pg {
    label="Postgres";
    style="dotted";

    campaigns_t     [label="campaigns\n  world_id (read)\n  status UNCHANGED\n   on prep failure"];
    preps_t         [label="session_preps\n  ft_context + sd_playbook\n  + opening (034)\n  UNIQUE(campaign_id,\n    session_number)\n  (migration 022)"];
    pipeline_runs_t [label="pipeline_runs\n  campaign_id, user_id NULL\n  stage='session-prep:{n}'"];
  }

  subgraph cluster_consume {
    label="SSE consumers";
    style="dotted";

    player [label="prep-status route\n  (always registered)\nplayer 'preparing…' screen", color="ember", fontcolor="ember"];
    devtool [label="prep-prose route\n  (AUTH_MODE=bypass ONLY,\n   absent in prod)\ndev-tool prose pane", color="ember", fontcolor="ember"];
  }

  // Enqueue + pickup
  trigger -> queue [label="add sp-{id}-{n}"];
  queue -> claim [label="job { campaignId,\n  sessionNumber }"];
  claim -> pipeline_runs_t [label="INSERT pending", style=dashed];

  // Read surface: SafeSessionPrep projection off the persisted rows
  preps_t -> reads [label="rows →\n  SafeSessionPrep\n  (no sd_playbook)", style=dotted, color="ember"];

  // Reset: one transaction — drop the row + re-arm the stage
  reset -> preps_t         [label="deleteFor", style=dashed, color="ember"];
  reset -> pipeline_runs_t [label="resetStage\n  → pending", style=dashed, color="ember"];

  // prep-started, then generation
  claim -> started;
  started -> phase_ch [label="prep-started", style=dashed];
  started -> resolve;
  resolve  -> campaigns_t [label="SELECT world_id", style=dotted];
  resolve  -> serialize;
  serialize -> llm;

  // myth-vb2ov graceful overflow: finishReason:'length' → ONE tighter-budget
  // retry (no deltas on the retry); a second overflow is a terminal fail.
  llm -> llm [label="finishReason:'length' →\n  retry ONCE\n  (tighter budget)", style=dashed, color="ember"];

  // Prose deltas stream to the dev-only channel as they arrive
  llm -> prose_ch [label="onProseDelta →\n  publishProse\n  ('prep-delta')", style=dashed, color="ember"];

  // Vet the opening against its own playbook, then persist + mark + prep-ready
  llm     -> vet;
  vet     -> persist [label="clean"];
  persist -> preps_t [label="ft_context +\n  sd_playbook +\n  opening", style=dotted];
  persist -> mark;
  mark    -> pipeline_runs_t [label="completed +\n  cost_usd", style=dotted];
  mark    -> phase_ch        [label="prep-ready", style=dashed];

  // Failure path
  llm  -> fail [label="error / 2nd overflow\n  ({terminal:true})", style=dashed, color="ember"];
  vet  -> fail [label="breach\n  (non-terminal)", style=dashed, color="ember"];
  fail -> pipeline_runs_t [label="failed + error", style=dotted];
  fail -> phase_ch        [label="prep-failed", style=dashed];
  fail -> campaigns_t     [label="status NOT\n  touched", style=dotted];

  // Consumption: phase → player; prose → dev tool
  phase_ch -> player  [label="phase only", style=dashed];
  prose_ch -> devtool [label="prep-delta", style=dashed];
}
