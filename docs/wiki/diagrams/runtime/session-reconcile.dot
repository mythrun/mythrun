digraph session_reconcile {
  // End-of-session lifecycle (MYT-74a + MYT-74b). Two triggers converge on
  // endSession (idempotent via a SET-NX `ending` flag): the explicit `end_session`
  // WS frame and the turn worker's budget-100% auto-end. MYT-74b SPLIT the end:
  // endSession only BEGINS it — claim flag, cancelSuspend, read watermark, enqueue
  // ONE player-less FAREWELL turn (jobId per-session). The turn worker renders the
  // send-off, then its `finally` runs finalizeEndedSession — the CONDITIONAL flip
  // to 'ended' (broadcast session_end exactly once) + enqueue reconcile + analysis
  // — so the live send-off precedes session_end. A QueueEvents backstop finalizes
  // the maxStalledCount terminal. Two off-hot-path jobs then run: RECONCILE folds
  // the working set into canon (the holistic Opus match/mint pass); ANALYSIS reads
  // the transcript → {summary, emergingThreads, handoff}, mechanically verifies the
  // handoff's verbatim excerpts (containment), and persists. ENFORCED IGNORANCE:
  // every log/alert carries STRUCTURAL codes + counts only, never plan/excerpt
  // content.
  rankdir=LR;
  compound=true;
  nodesep=0.4;
  ranksep=0.8;

  subgraph cluster_triggers {
    label="Two end triggers  →  begin ending";
    style="dashed";
    color="ember";
    fontcolor="ember";

    ws_end   [label="end_session WS frame\n(explicit summon,\n no payload)", color="ember", fontcolor="ember"];
    budget   [label="turn worker\nbudget-100% auto-end\n(post-flush phase)", color="ember", fontcolor="ember"];
    endfn    [label="endSession — BEGIN only\nSET-NX `ending` flag →\ncancelSuspend → read watermark →\nenqueue ONE farewell turn\n(does NOT finalize)", color="ember", fontcolor="ember"];
  }

  subgraph cluster_farewell {
    label="The farewell turn  →  finalize";
    style="dashed";
    color="ember";
    fontcolor="ember";

    farewell [label="farewell turn (player-less)\n[DM direction:] silent-consume seam\nFT renders the send-off prose\nno watermark / no Scribe / no budget", color="ember", fontcolor="ember"];
    finalize [label="finalizeEndedSession\n(turn `finally`, unconditional)\nconditional markEnded (flip 'ended')\n→ broadcast session_end ONCE\n→ enqueue reconcile + analysis", color="ember", fontcolor="ember"];
    backstop [label="QueueEvents backstop\n(maxStalledCount terminal)\nidempotent finalize", color="ember", fontcolor="ember"];
  }

  subgraph cluster_pg_lifecycle {
    label="Postgres  (lifecycle)";
    style="dashed";

    row    [label="sessions row\nstatus='ended', ended_at=now\nreconciled_at = NULL, summary = NULL\n(tri-state: ended ≠ reconciled)"];
    interlock [label="POST /sessions/:id/start\n409 reconcile_pending (ended +\nreconciled_at NULL)\n409 session_ending (flag set)", color="ember", fontcolor="ember"];
  }

  subgraph cluster_batch {
    label="redisBatch";
    style="dotted";
    q_recon [label="queue: session-reconcile\njobId reconcile-{sessionId}\nattempts 5 · exp backoff", color="ember", fontcolor="ember"];
    q_anal  [label="queue: session-analysis\njobId analysis-{sessionId}\nattempts 5 · exp backoff", color="ember", fontcolor="ember"];
  }

  subgraph cluster_worker {
    label="Reconcile worker  (concurrency 1 · 180s lock)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    proc   [label="processReconcileJob (NOT total)\ngate-read → lock → load →\nretrieve → render → reconcile →\nvalidate → embed → commit → clear", color="ember", fontcolor="ember"];
    retrieve [label="findSimilarEntities\n(per distinct subject, top-K)\n+ live candidate facts\n(superseded_by IS NULL)"];
    opus   [label="Opus reconciler (ONE call)\nmatch/mint · fact append ±\nsupersede · relationship edges\nredactRawText · pinned cap", color="ember", fontcolor="ember"];
    validate [label="validate (PURE, security-critical)\nsubjectName→entityId map\ndangling refs · tier floor ·\nattribution arm → reject CODE only", color="ember", fontcolor="ember"];
    commit [label="commit (ONE tx)\nmint entities · append facts ·\nsupersede + NULL embedding ·\nedges · hierarchy · markTouchedByPlay\nconditional markReconciled (LAST)", color="ember", fontcolor="ember"];
  }

  subgraph cluster_analysis {
    label="Analysis worker  (concurrency 1 · 180s lock)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    aproc  [label="processPostSessionAnalysisJob (NOT total)\nsummary IS NULL gate → load\ndurable inputs → analyze →\nverify → writeAnalysis (gated)", color="ember", fontcolor="ember"];
    aopus  [label="Opus analyst (ONE call)\ntranscript tail + sd_playbook +\nrunning summary + roster →\n{summary, emergingThreads, handoff}\nredactRawText · pinned cap", color="ember", fontcolor="ember"];
    contain [label="containment verifier (PURE)\ndrop any voice/atmosphere excerpt\nNOT verbatim in a non-correction/\nfarewell transcript row", color="ember", fontcolor="ember"];
  }

  subgraph cluster_realtime {
    label="Redis (realtime)";
    style="dashed";
    ws_list [label="session:{cId}:workingset\n(MYT-73 — tier+provenance\nannotated improvisation)\nclear() on a winning commit", color="ember", fontcolor="ember"];
    flag    [label="session:{cId}:ending\n(SET-NX once-only)"];
  }

  subgraph cluster_canon {
    label="Durable narrative state  (Postgres + pgvector)";
    style="dashed";
    facts  [label="facts (append-only)\nsuperseded_by / superseded_at\nlive = superseded_by IS NULL\nsource='session'", color="ember", fontcolor="ember"];
    entities [label="entities\ncreated_in='session:<id>'\nmodified_by_play=true"];
    edges  [label="relationships +\nentity_hierarchy\n(session edges)"];
    narr   [label="sessions.summary\n{summary, emergingThreads}\nsessions.handoff (SessionHandoff)\n→ next session's prep", color="ember", fontcolor="ember"];
  }

  // Triggers begin the end
  ws_end -> endfn [label="WS route"];
  budget -> endfn [label="post-flush\n(idempotent)", color="ember"];
  endfn  -> flag  [label="SET-NX claim", style=dotted];
  endfn  -> farewell [label="enqueue ONE\nfarewell turn", color="ember"];

  // The farewell renders, then finalizes
  farewell -> finalize [label="render done →\n`finally`", color="ember"];
  farewell -> backstop [label="terminal stall", style=dotted, color="ember"];
  backstop -> finalize [label="idempotent", style=dotted, color="ember"];
  finalize -> row   [label="conditional flip\n→ session_end once", color="ember"];
  finalize -> q_recon [label="enqueue", color="ember"];
  finalize -> q_anal  [label="enqueue", color="ember"];

  // The interlock reads the tri-state + the flag
  row -> interlock [label="reconciled_at NULL\n→ block start", style=dotted, color="ember"];
  flag -> interlock [label="set → block start", style=dotted, color="ember"];

  // Reconcile pipeline
  q_recon -> proc  [label="+ retry (idempotent)", color="ember"];
  ws_list -> proc  [label="load (durable\ncheckpoint source)", color="ember"];
  proc -> retrieve [label="1. retrieve"];
  retrieve -> opus [label="2. candidates + live facts"];
  opus -> validate [label="3. plan"];
  validate -> commit [label="4. ok + map", color="ember"];
  validate -> proc  [label="reject CODE\n→ throw (retry)", style=dotted];

  commit -> facts;
  commit -> entities;
  commit -> edges;
  commit -> row    [label="conditional\nmarkReconciled\n(0 rows → ROLLBACK)", color="ember"];
  commit -> ws_list [label="clear() on win", style=dashed, color="ember"];

  // Analysis pipeline
  q_anal -> aproc [label="+ retry (idempotent)", color="ember"];
  aproc -> aopus  [label="analyze"];
  aopus -> contain [label="handoff"];
  contain -> narr  [label="writeAnalysis\n(summary IS NULL gate)", color="ember"];
}
