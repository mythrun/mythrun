digraph session_turn {
  // The DM-turn pipeline (PG-direct, MYT-68). A trigger enqueues a session-turn
  // job on redisBatch; the session-turn worker (in the dedicated worker.ts
  // process) acquires the per-session distributed lock, runs the §5 decision
  // order (converge a durable turn / terminate a streamed-but-uncommitted turn
  // / render fresh), and on a fresh run drives a transient SessionController
  // through the deterministic single-tier conductor (the FT — MYT-69 retired the
  // in-turn ST seam, MYT-73 retired the on-path Scribe seam; both now run in
  // their own post-turn workers). The FT is REAL (Sonnet). The fresh-run arm
  // takes the one-shot
  // direction (GETDEL) + reads the standing directive from trigger-state and
  // fuses/appends them. The conductor RECONSTRUCTS the FT history from
  // session_messages (PG) each turn — the Redis ft_history hot cache is retired.
  // The rendered DM turn persists as ONE atomic, idempotent PG append (the
  // single durability point); only the small {usage} flushes to Redis, and the
  // post-turn finally enqueues the st-evaluation AND the scribe job (skipped on a
  // player-less `correction` turn). The worker holds no socket:
  // it PUBLISHes frames to the per-campaign channel, which the API containers'
  // SessionHub fans out to live WebSockets.
  rankdir=LR;
  compound=true;
  nodesep=0.4;
  ranksep=0.8;

  trigger [label="trigger\n(dev fire-turn route ·\n MYT-67 player chat)\nenqueueTurn(payload)", color="ember", fontcolor="ember"];

  subgraph cluster_batch {
    label="redisBatch";
    style="dotted";
    q_turn [label="queue: session-turn\nno custom jobId · attempts\nmaxStalledCount 3"];
  }

  subgraph cluster_worker {
    label="Worker process  —  node dist/worker.js";
    style="dashed";
    color="ember";
    fontcolor="ember";

    proc [label="processTurnJob\ntryAcquire lock → heartbeat\n§5 decision: converge / terminal / fresh\nrelease in finally", color="ember", fontcolor="ember"];
    ctrl [label="SessionController (transient)\nload → reconstruct history → fuse one-shot →\nrender → persistTurn → flushToRedis · GC'd per turn"];
    tiers [label="conductor (deterministic)\nfuse one-shot → FT.render(emit)\n→ enqueueScribeJob (assemble)\n(FT REAL — Sonnet; Scribe + ST off-path)", color="ember", fontcolor="ember"];
    pub  [label="TurnPublisher (latched emitter)\nPUBLISH dm_thinking / text_delta /\n  skill_check / dice_roll / turn_end / turn_error"];
  }

  subgraph cluster_pg {
    label="Postgres";
    style="dashed";
    color="ember";
    fontcolor="ember";

    msgs [label="session_messages\nplayer rows + DM-turn rows\n(THE transcript store · §3.7)\nlistFtContextRows / appendDmTurn", color="ember", fontcolor="ember"];
  }

  subgraph cluster_realtime {
    label="Redis (realtime cluster)";
    style="dashed";
    color="ember";
    fontcolor="ember";

    lock  [label="session:lock:{cId}\nSET NX PX (token)\nLua compare-extend / -release"];
    turnstate [label="session:{cId}:usage · :seq · :state\n:summary (ST job's — not flushed here)\ndirection:oneshot (GETDEL) · direction:standing (read)\n(NO ft_history — retired)"];
    channel [label="session:campaign:{cId}\n(PUBLISH frame JSON)", color="ember", fontcolor="ember"];
  }

  subgraph cluster_api {
    label="API process  (per ECS task)";
    style="dashed";
    hub [label="SessionHub\nPSUBSCRIBE session:campaign:*\nfan out to local sockets"];
  }

  client [label="player / SPA\ndedup on turnId", color="ember", fontcolor="ember"];
  steval [label="st-evaluation queue\n(post-hoc SlowThinker)\nenqueued on flushed success", color="ember", fontcolor="ember"];
  scribe [label="scribe queue\n(post-turn Scribe)\nprose + delta + injections\n(skipped on correction)", color="ember", fontcolor="ember"];

  trigger -> q_turn  [label="add job"];
  q_turn  -> proc    [label="BLPOP-style\n+ stalled redelivery"];

  proc -> lock [label="tryAcquire / extend\n/ release (compare-and-delete)"];

  proc -> ctrl  [label="new + drive (fresh run)"];
  ctrl -> tiers [label="conductor"];
  ctrl -> msgs  [label="reconstruct history\n+ persist DM turn (atomic)", color="ember"];
  ctrl -> turnstate [label="load / flush {usage}\ntake one-shot · read standing"];

  tiers   -> pub     [label="emit text / skill_check / dice_roll"];
  proc    -> pub     [label="dm_thinking / turn_end", style=dashed];
  pub     -> channel [label="PUBLISH"];
  channel -> hub     [label="pmessage\n(every container)", color="ember"];
  hub     -> client  [label="ws.send"];
  proc    -> steval  [label="post-turn enqueue\n(off the hot path)", style=dashed, color="ember"];
  ctrl    -> scribe  [label="enqueueScribeJob\n(flushed success)", style=dashed, color="ember"];
  scribe  -> q_turn  [label="correction turn\n(retcon Z)", style=dotted, color="ember"];
}
