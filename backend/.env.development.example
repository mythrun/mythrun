# Data layer (docker-compose)
DATABASE_URL=postgresql://mythrun:mythrun_dev@localhost:5432/mythrun
REDIS_REALTIME_URL=redis://localhost:6379
REDIS_BATCH_URL=redis://localhost:6380

# Deployment env + region. Combined into the Redis key prefix
# (`${MYTHRUN_ENV}:${REGION_PREFIX}:`) so staging and prod, which share one
# ElastiCache cluster, keep their keyspaces disjoint. Must be one of
# {production, staging, development}.
MYTHRUN_ENV=development
REGION_PREFIX=use1

# External services — replace sentinels with real keys before exercising the
# corresponding integrations. Sentinels are obviously-fake to avoid GitHub
# secret-scanning false positives if this file is accidentally edited.
# ANTHROPIC_API_KEY pulls from Anthropic Console
# (https://console.anthropic.com/settings/keys). Test keys are fine for
# local dev. Required at boot; env.ts enforces the sk-ant- prefix.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME_dev_only
STRIPE_SECRET_KEY=REPLACE_ME_dev_only
STRIPE_WEBHOOK_SECRET=REPLACE_ME_dev_only

# Auth mode: bypass (dev) | real (staging/prod)
AUTH_MODE=bypass

# Server
PORT=3000

# Opt into the MYT-29 boot gate (validates env, opens pg/redis connections,
# probes them with retry-backoff before listen). Disabled by default in
# staging/prod until Backend Core lands schema + migrations and
# bootstrap-databases.sh sets the real RDS password (myth-ml8).
BOOT_GATE_ENABLED=1
