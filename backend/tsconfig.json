{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "dist",
    "declaration": false,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  // scripts/ is included so ESLint's typescript-eslint projectService can
  // parse files like scripts/dev-tool-check.ts under the strict-typed
  // ruleset. The build (tsconfig.build.json) excludes scripts/ to keep
  // dist/ clean — only src/** is emitted. rootDir is intentionally
  // unset; tsc infers it from included files per config (src+scripts for
  // typecheck, src-only for build).
  "include": ["src/**/*", "scripts/**/*"]
}
