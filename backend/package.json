{
  "name": "@mythrun/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src",
    "scripts/smoke"
  ],
  "scripts": {
    "dev": "bash scripts/dev-logged.sh",
    "dev:raw": "tsx watch --env-file=.env.development --env-file-if-exists=../.env.worktree src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/llm/prompts dist/llm/prompts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree src/db/migrate.ts",
    "db:migrate:test": "set -a && . ./.env.development && [ -f ../.env.worktree ] && . ../.env.worktree; set +a; DATABASE_URL=\"$DATABASE_URL_TEST\" tsx src/db/migrate.ts",
    "db:migrate:compiled": "node dist/db/migrate.js",
    "world:embed-backfill": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree scripts/world-embed-backfill.ts",
    "dev-tool:check": "tsx scripts/dev-tool-check.ts",
    "smoke:phantom-reconciliation": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree scripts/smoke/phantom-reconciliation.ts",
    "smoke:entity-consolidation-flow": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree scripts/smoke/entity-consolidation-flow.ts",
    "smoke:prep-pipeline": "tsx --env-file=.env.smoke --env-file-if-exists=../.env.worktree scripts/smoke/prep-pipeline.ts",
    "smoke:session-prep": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree scripts/smoke/session-prep.ts",
    "smoke:world-retrieval": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree scripts/smoke/world-retrieval-voyage.ts",
    "smoke:world-lookup": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree scripts/smoke/world-lookup-vet.ts",
    "smoke:scribe": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree scripts/smoke/myt-73-scribe-smoke.ts",
    "smoke:reconcile": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree scripts/smoke/myt-74a-reconcile-smoke.ts",
    "capture:ready-to-play": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree scripts/smoke/fixtures/capture.ts ready-to-play-campaign"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@ai-sdk/provider": "^3.0.10",
    "@aws-sdk/client-cognito-identity-provider": "^3.1055.0",
    "@aws-sdk/client-secrets-manager": "^3.1055.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.0.0",
    "ai": "^6.0.176",
    "aws-jwt-verify": "^5.1.1",
    "bullmq": "^5.76.8",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "stripe": "^22.1.0",
    "tsx": "^4.19.0",
    "uuidv7": "^1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.7",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.4.2",
    "ioredis-mock": "^8.13.1",
    "jsdom": "^25.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.3"
  }
}
