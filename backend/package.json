{
  "name": "@mythrun/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env.development --env-file-if-exists=../.env.worktree src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/llm/prompts dist/llm/prompts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree src/db/migrate.ts",
    "db:migrate:test": "set -a && . ./.env.development && [ -f ../.env.worktree ] && . ../.env.worktree; set +a; DATABASE_URL=\"$DATABASE_URL_TEST\" tsx src/db/migrate.ts",
    "db:migrate:compiled": "node dist/db/migrate.js",
    "dev-tool:check": "tsx scripts/dev-tool-check.ts",
    "smoke:phantom-reconciliation": "tsx --env-file=.env.development --env-file-if-exists=../.env.worktree scripts/smoke/phantom-reconciliation.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@ai-sdk/provider": "^3.0.10",
    "@fastify/rate-limit": "^10.3.0",
    "ai": "^6.0.176",
    "aws-jwt-verify": "^5.1.1",
    "bullmq": "^5.76.8",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "stripe": "^22.1.0",
    "uuidv7": "^1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.7",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.4.2",
    "ioredis-mock": "^8.13.1",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
