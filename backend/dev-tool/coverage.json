{
  "version": 1,
  "routes": [
    "GET /api/campaigns/:campaignId/status",
    "GET /api/campaigns/:campaignId/status/stream",
    "GET /api/campaigns/:campaignId/prep-status",
    "POST /api/campaigns",
    "GET /api/campaigns/:campaignId",
    "GET /api/campaigns/mine",
    "POST /api/campaigns/:campaignId/resume",
    "DELETE /api/campaigns/:campaignId",
    "PATCH /api/campaigns/:campaignId/name",
    "GET /api/campaigns/:campaignId/world-snapshot",
    "POST /api/campaigns/:campaignId/starting-situation",
    "POST /api/campaigns/:campaignId/characters",
    "GET /api/campaigns/:campaignId/starting-situations",
    "GET /api/campaigns/:campaignId/characters",
    "GET /api/campaigns/:campaignId/characters/:charId",
    "GET /api/campaigns/:campaignId/hierarchy",
    "GET /api/campaigns/:campaignId/random-tables",
    "GET /api/campaigns/:campaignId/character-creation-progress",
    "POST /api/campaigns/:campaignId/finalize-character-creation"
  ],
  "events": [
    "phase",
    "stage-started",
    "stage-completed",
    "stage-failed",
    "cost-update",
    "job-failed",
    "stage-reset",
    "entity-added",
    "entity-updated",
    "entity-removed",
    "edge-added",
    "edge-removed",
    "fact-added",
    "fact-removed",
    "fact-updated",
    "finalized",
    "prep-started",
    "prep-ready",
    "prep-failed"
  ],
  "jobs": ["world-gen", "character-creation", "character-integration", "session-prep"],
  "exempt": {
    "routes": {
      "GET /api/campaigns/:campaignId/wiki": "MYT-74c — player-facing member-readable campaign wiki (narrow known-tier). Not a dev-tool inspector surface: the owner-only world-snapshot panel already covers world inspection. This route exists for the player UI (a Frontend ticket), so it has no dev-tool panel; mirrors EXEMPT_ROUTES in verify-registry.ts.",
      "GET /api/campaigns/:campaignId/transcript/search": "MYT-74d — player-facing full-text transcript search (member-readable). Not a dev-tool inspector surface; the player UI (a Frontend ticket) owns the search box, so it has no dev-tool panel; mirrors EXEMPT_ROUTES in verify-registry.ts."
    },
    "events": {},
    "jobs": {}
  }
}
