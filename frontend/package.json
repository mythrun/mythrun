{
  "name": "@mythrun/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude '**/config-wiring.test.ts' --exclude '**/*.wiring.test.ts'",
    "i18n:todo": "node scripts/i18n-todo.mjs",
    "smoke:home-hub": "tsx src/smoke/home-hub.smoke.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --url http://127.0.0.1:6006",
    "test-storybook:ci": "concurrently -k -s first -n SB,TEST -c magenta,blue \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && pnpm test-storybook\"",
    "screen-story-coverage": "node scripts/screen-story-coverage.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/source-serif-4": "^5.0.0",
    "@mythrun/contract": "workspace:*",
    "@mythrun/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.0",
    "@mythrun/client-core": "workspace:*",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@storybook/test-runner": ">=0.19.0 <0.24.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.1.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.0",
    "msw": "^2.6.0",
    "playwright": "^1.61.1",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.1"
  }
}
