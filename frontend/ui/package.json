{
  "name": "@mythrun/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "build:tokens": "node ../client-core/src/tokens/generate-palette.mjs ./src/styles",
    "build": "pnpm build:tokens"
  },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "dependencies": {
    "@fontsource/source-serif-4": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@mythrun/client-core": "workspace:*"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
