{
  "name": "@mythrun/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "lint:css": "stylelint 'src/components/**/*.css' --allow-empty-input",
    "story-coverage": "node scripts/story-coverage.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:tokens": "node ../client-core/src/tokens/generate-palette.mjs ./src/styles",
    "build": "pnpm build:tokens"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@mythrun/client-core": "workspace:*",
    "@mythrun/contract": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^9.1.20",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^9.1.20",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
