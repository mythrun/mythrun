{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c 'if ((.tool_input.file_path // \"\") | test(\"docs/superpowers/plans/.*\\\\.md$\")) then {hookSpecificOutput:{hookEventName:\"PostToolUse\",additionalContext:\"You just wrote or edited an implementation plan. Decompose it into beads now: run `bd create` for each concrete step, wire `bd dep` for blockers. Required by the CLAUDE.md workflow — do this BEFORE starting implementation.\"}} else empty end'"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/post-spec-write.sh"
          }
        ]
      },
      {
        "matcher": "mcp__linear-server__save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/post-linear-close.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/post-brainstorm-skill.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/post-bash-git-push.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/user-prompt-submit-ci-status.sh"
          }
        ]
      }
    ]
  }
}
